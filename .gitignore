# ROS 2 构建产物（由 colcon build 生成，不入库）
build/
install/
log/

# Python 缓存与编译产物
__pycache__/
*.pyc
*.py[cod]
*$py.class
*.egg-info/
.ruff_cache/
.pytest_cache/

# 临时目录 / 本地导出产物
/tmp/
tmp/
*.zip

# 编辑器 / IDE（.vscode 里含 1GB 的 browse.vc.db 索引，绝不入库）
.vscode/
.idea/

# 系统杂物
.DS_Store
*.swp
*~

# 固件本地凭据（含明文 Wi-Fi 密码，绝不可入库）
# 只提交 wifi_credentials.h.example 模板
wifi_credentials.h

# 大体积原版 PDF 手册（仓库只保留精简文本规范 e2_ver_1_0_1.md）
*.pdf

# E2 真机/ Mock 导出地图：只保留目录占位，不入库未筛选的二进制与栅格产物
**/e2_maps/*.map
**/e2_maps/*.pgm
**/e2_maps/*.yaml
!**/e2_maps/.gitkeep

# WorkBuddy 工作数据，不公开
.workbuddy/
