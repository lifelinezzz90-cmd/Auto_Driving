<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="slam_room">

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- 8m x 8m 封闭房间外墙与内部非对称隔断 -->
    <model name="slam_walls">
      <static>true</static>
      <link name="walls_link">

        <!-- 北外墙 -->
        <collision name="north_wall_collision">
          <pose>0 4.0 0.6 0 0 0</pose>
          <geometry>
            <box>
              <size>8.2 0.2 1.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="north_wall_visual">
          <pose>0 4.0 0.6 0 0 0</pose>
          <geometry>
            <box>
              <size>8.2 0.2 1.2</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/WoodFloor</name>
            </script>
          </material>
        </visual>

        <!-- 南外墙 -->
        <collision name="south_wall_collision">
          <pose>0 -4.0 0.6 0 0 0</pose>
          <geometry>
            <box>
              <size>8.2 0.2 1.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="south_wall_visual">
          <pose>0 -4.0 0.6 0 0 0</pose>
          <geometry>
            <box>
              <size>8.2 0.2 1.2</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/WoodFloor</name>
            </script>
          </material>
        </visual>

        <!-- 东外墙 -->
        <collision name="east_wall_collision">
          <pose>4.0 0 0.6 0 0 0</pose>
          <geometry>
            <box>
              <size>0.2 8.0 1.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="east_wall_visual">
          <pose>4.0 0 0.6 0 0 0</pose>
          <geometry>
            <box>
              <size>0.2 8.0 1.2</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/WoodFloor</name>
            </script>
          </material>
        </visual>

        <!-- 西外墙 -->
        <collision name="west_wall_collision">
          <pose>-4.0 0 0.6 0 0 0</pose>
          <geometry>
            <box>
              <size>0.2 8.0 1.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="west_wall_visual">
          <pose>-4.0 0 0.6 0 0 0</pose>
          <geometry>
            <box>
              <size>0.2 8.0 1.2</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/WoodFloor</name>
            </script>
          </material>
        </visual>

        <!-- 内部 L 型走廊隔断 1 (纵向) -->
        <collision name="inner_wall_1_collision">
          <pose>1.0 1.25 0.6 0 0 0</pose>
          <geometry>
            <box>
              <size>0.2 2.5 1.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="inner_wall_1_visual">
          <pose>1.0 1.25 0.6 0 0 0</pose>
          <geometry>
            <box>
              <size>0.2 2.5 1.2</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>

        <!-- 内部 L 型走廊隔断 2 (横向拐角) -->
        <collision name="inner_wall_2_collision">
          <pose>-0.25 2.5 0.6 0 0 0</pose>
          <geometry>
            <box>
              <size>2.5 0.2 1.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="inner_wall_2_visual">
          <pose>-0.25 2.5 0.6 0 0 0</pose>
          <geometry>
            <box>
              <size>2.5 0.2 1.2</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>

        <!-- 内部非对称隔断 3 (左下区域分流墙) -->
        <collision name="inner_wall_3_collision">
          <pose>-1.8 -1.5 0.6 0 0 0</pose>
          <geometry>
            <box>
              <size>0.2 2.6 1.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="inner_wall_3_visual">
          <pose>-1.8 -1.5 0.6 0 0 0</pose>
          <geometry>
            <box>
              <size>0.2 2.6 1.2</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>

      </link>
    </model>

    <!-- 静态障碍物 1: 右下方圆柱 -->
    <model name="obstacle_cylinder_1">
      <static>true</static>
      <pose>2.4 -2.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.35</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.35</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Blue</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- 静态障碍物 2: 右下方方柱 -->
    <model name="obstacle_box_1">
      <static>true</static>
      <pose>1.2 -2.8 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.6 0.6 0.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.6 0.6 0.8</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Red</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- 静态障碍物 3: 左上方圆柱 -->
    <model name="obstacle_cylinder_2">
      <static>true</static>
      <pose>-2.6 1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.4</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.4</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Green</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- 静态障碍物 4: 右上方走廊外方柱 -->
    <model name="obstacle_box_2">
      <static>true</static>
      <pose>2.6 2.2 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.7 0.5 0.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.7 0.5 0.8</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Yellow</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- 物理引擎场景参数配置 -->
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>0.0 -7.0 10.0 0 0.95 1.57</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- 仿真汇报全景高清渲染相机 -->
    <model name="report_camera">
      <static>true</static>
      <pose>0.0 -6.2 8.2 0 0.86 1.5708</pose>
      <link name="link">
        <sensor name="scene_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>10.0</update_rate>
          <camera>
            <horizontal_fov>1.15</horizontal_fov>
            <image>
              <width>1600</width>
              <height>1000</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
          <plugin name="scene_camera_driver" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/gazebo_scene</namespace>
              <remapping>image_raw:=image_raw</remapping>
            </ros>
            <camera_name>overview</camera_name>
            <frame_name>scene_camera_optical_frame</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
